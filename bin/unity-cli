#!/usr/bin/env bash
set -euo pipefail

PROJECT_PATH="${1:-}"
ACTION="${2:-status}"
if [[ -z "$PROJECT_PATH" ]]; then
  echo "Usage: unity-cli PROJECT {status|version|compile|tests [EditMode|PlayMode]|execute METHOD}" >&2
  exit 2
fi
PROJECT_PATH="$(cd "$PROJECT_PATH" 2>/dev/null && pwd)" || {
  echo "Project directory does not exist: $PROJECT_PATH" >&2
  exit 2
}
if [[ ! -f "$PROJECT_PATH/ProjectSettings/ProjectVersion.txt" ]]; then
  echo "Not a Unity project: $PROJECT_PATH" >&2
  exit 2
fi

UNITY_VERSION="$(awk '/m_EditorVersion:/ {print $2; exit}' "$PROJECT_PATH/ProjectSettings/ProjectVersion.txt")"

find_unity_binary() {
  if [[ -n "${UNITY_EDITOR_PATH:-}" ]]; then
    printf '%s\n' "$UNITY_EDITOR_PATH"
    return
  fi

  local candidate
  case "$(uname -s)" in
    Darwin)
      printf '/Applications/Unity/Hub/Editor/%s/Unity.app/Contents/MacOS/Unity\n' "$UNITY_VERSION"
      ;;
    Linux)
      for candidate in \
        "$HOME/Unity/Hub/Editor/$UNITY_VERSION/Editor/Unity" \
        "$HOME/Unity/Hub/Editor/$UNITY_VERSION/Unity" \
        "/opt/Unity/Hub/Editor/$UNITY_VERSION/Editor/Unity" \
        "/usr/local/Unity/Hub/Editor/$UNITY_VERSION/Editor/Unity" \
        "/opt/unity/Editor/Unity"; do
        if [[ -x "$candidate" ]]; then
          printf '%s\n' "$candidate"
          return
        fi
      done
      printf '%s/Unity/Hub/Editor/%s/Editor/Unity\n' "$HOME" "$UNITY_VERSION"
      ;;
    *)
      printf '%s\n' "Unity"
      ;;
  esac
}

UNITY_BIN="$(find_unity_binary)"
RUN_DIR="$PROJECT_PATH/.unity-opencode"

is_open() {
  local line
  while IFS= read -r line; do
    [[ "$line" == *'AssetImportWorker'* ]] && continue
    [[ "$line" == *"$PROJECT_PATH"* ]] || continue
    if [[ "$line" == *'/Unity.app/Contents/MacOS/Unity'* || "$line" == *'/Editor/Unity'* ]]; then
      return 0
    fi
  done < <(ps ax -o command=)
  return 1
}

require_closed() {
  if is_open; then
    echo "Refusing Unity batch mode: this project is already open. Use Unity MCP for live-editor work." >&2
    exit 5
  fi
}

run_unity() {
  if [[ ! -x "$UNITY_BIN" ]]; then
    echo "Unity executable not found: $UNITY_BIN" >&2
    exit 3
  fi
  mkdir -p "$RUN_DIR"
  "$UNITY_BIN" -batchmode -nographics -quit -projectPath "$PROJECT_PATH" "$@"
}

case "$ACTION" in
  status)
    printf 'project=%s\nunity_version=%s\nunity_executable=%s\neditor_open=%s\n' \
      "$PROJECT_PATH" "$UNITY_VERSION" "$UNITY_BIN" "$(is_open && echo yes || echo no)"
    ;;
  version)
    echo "$UNITY_VERSION"
    ;;
  compile)
    require_closed
    run_unity -logFile "$RUN_DIR/compile.log"
    ;;
  tests)
    require_closed
    MODE="${3:-EditMode}"
    if [[ "$MODE" != "EditMode" && "$MODE" != "PlayMode" ]]; then
      echo "Test mode must be EditMode or PlayMode." >&2
      exit 2
    fi
    mkdir -p "$RUN_DIR"
    run_unity -runTests -testPlatform "$MODE" \
      -testResults "$RUN_DIR/TestResults-$MODE.xml" \
      -logFile "$RUN_DIR/tests-$MODE.log"
    ;;
  execute)
    require_closed
    METHOD="${3:-}"
    if [[ -z "$METHOD" ]]; then
      echo "execute requires a fully qualified static method." >&2
      exit 2
    fi
    run_unity -executeMethod "$METHOD" -logFile "$RUN_DIR/execute.log" "${@:4}"
    ;;
  *)
    echo "Unknown action: $ACTION" >&2
    exit 2
    ;;
esac
