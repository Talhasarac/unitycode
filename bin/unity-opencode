#!/usr/bin/env bash
set -euo pipefail

HARNESS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_PATH="${1:-$PWD}"
if [[ $# -gt 0 ]]; then shift; fi
PROJECT_PATH="$(cd "$PROJECT_PATH" 2>/dev/null && pwd)" || {
  echo "Project directory does not exist: $PROJECT_PATH" >&2
  exit 2
}

if [[ ! -d "$PROJECT_PATH/Assets" || ! -d "$PROJECT_PATH/Packages" || ! -d "$PROJECT_PATH/ProjectSettings" ]]; then
  echo "Not a Unity project: $PROJECT_PATH" >&2
  exit 2
fi

if ! command -v opencode >/dev/null 2>&1; then
  echo "OpenCode is not installed or is not on PATH." >&2
  exit 3
fi

KEY_FILE="${UNITY_OPENCODE_KEY_FILE:-$HOME/.config/unity-opencode-harness/deepinfra.key}"
if [[ -z "${DEEPINFRA_API_KEY:-}" && -f "$KEY_FILE" ]]; then
  DEEPINFRA_API_KEY="$(tr -d '\r\n' < "$KEY_FILE")"
  export DEEPINFRA_API_KEY
fi

if [[ -z "${UNITY_MCP_URL:-}" ]]; then
  PORT=""
  for PID_FILE in "$PROJECT_PATH"/Library/MCPForUnity/RunState/mcp_http_*.pid; do
    [[ -f "$PID_FILE" ]] || continue
    CANDIDATE="${PID_FILE##*_}"
    CANDIDATE="${CANDIDATE%.pid}"
    if [[ "$CANDIDATE" =~ ^[0-9]+$ ]]; then
      PORT="$CANDIDATE"
      break
    fi
  done
  PORT="${PORT:-8080}"
  UNITY_MCP_URL="http://127.0.0.1:${PORT}/mcp"
  export UNITY_MCP_URL
fi

export OPENCODE_CONFIG="$HARNESS_ROOT/opencode.jsonc"
export OPENCODE_CONFIG_DIR="$HARNESS_ROOT"
export OPENCODE_TUI_CONFIG="$HARNESS_ROOT/tui.json"

cd "$PROJECT_PATH"
USE_DEFAULT_AGENT=true
USE_DEFAULT_MODEL=true
for ARG in "$@"; do
  if [[ "$ARG" == "--agent" || "$ARG" == --agent=* ]]; then
    USE_DEFAULT_AGENT=false
  fi
  if [[ "$ARG" == "--model" || "$ARG" == --model=* || "$ARG" == "-m" ]]; then
    USE_DEFAULT_MODEL=false
  fi
done

DEFAULT_ARGS=()
if [[ "$USE_DEFAULT_AGENT" == true ]]; then
  DEFAULT_ARGS+=(--agent unity)
fi
if [[ "$USE_DEFAULT_MODEL" == true && -n "${UNITY_OPENCODE_MODEL:-}" ]]; then
  DEFAULT_ARGS+=(--model "$UNITY_OPENCODE_MODEL")
fi

if [[ $# -eq 0 ]]; then
  exec opencode "${DEFAULT_ARGS[@]}" "$PROJECT_PATH"
fi
exec opencode "${DEFAULT_ARGS[@]}" "$@"
