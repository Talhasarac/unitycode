{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:UNITY_OPENCODE_MODEL}",
  "provider": {
    "deepinfra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepInfra",
      "options": {
        "baseURL": "https://api.deepinfra.com/v1/openai",
        "apiKey": "{env:DEEPINFRA_API_KEY}"
      },
      "models": {
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi K2.7 Code (Unity harness)",
          "limit": { "context": 262144, "output": 32768 }
        },
        "Qwen/Qwen3.5-397B-A17B": {
          "name": "Qwen 3.5 397B (Unity harness)",
          "limit": { "context": 262144, "output": 32768 }
        },
        "deepseek-ai/DeepSeek-V4-Flash-Vision-Exp": {
          "name": "DeepSeek V4 Flash Vision (Unity harness)",
          "limit": { "context": 1048576, "output": 32768 }
        }
      }
    }
  },
  "mcp": {
    "unity": {
      "type": "remote",
      "url": "{env:UNITY_MCP_URL}",
      "enabled": true,
      "timeout": 120000
    }
  },
  "instructions": ["./AGENTS.md"],
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "unity_*": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rg *": "allow",
      "find *": "allow"
    }
  }
}

